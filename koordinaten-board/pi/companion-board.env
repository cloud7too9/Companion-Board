# Einstellungen der API auf dem Pi (/etc/companion-board.env). Domain: mainhubv1.com.
# Nur der Tunnel erreicht den Server (Umbau Phase 1): lauscht nur auf localhost
HOST=127.0.0.1
PORT=3000
# Datenordner (daten.db, geheim.txt, anzeige-link.txt)
DATEN_ORDNER=/var/lib/companion-board
# Die Seiten kommen von Netlify: Adresse im QR-Code (Anmeldeseite /) und im Anzeige-Link
OEFFENTLICHE_URL=https://mainhubv1.com
# Ursprünge, die /api und /ws aus dem Browser nutzen dürfen (CORS, Phase 1)
ERLAUBTE_URSPRUENGE=https://mainhubv1.com,https://www.mainhubv1.com
LOG_LEVEL=warn
